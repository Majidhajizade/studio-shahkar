    background:
        #111;

    color:
        var(--gold2);

    border:
        1px solid
        var(--gold);

}


.whatsapp {

    background:
        #25D366;

    color:
        white;

}


/* =====================================================
   REVEAL — STUDIO SHAHKAR
===================================================== */

.reveal {
    opacity: 0;
    transform: translateY(45px) scale(.96);
    transition:
        opacity .8s cubic-bezier(.22,1,.36,1),
        transform .8s cubic-bezier(.22,1,.36,1);
}

.reveal.show {
    opacity: 1;
    transform: translateY(0) scale(1);
}

/* Services — stagger animation */

#services .service-card:nth-child(1) {
    transition-delay: .05s;
}

#services .service-card:nth-child(2) {
    transition-delay: .18s;
}

#services .service-card:nth-child(3) {
    transition-delay: .31s;
}

#services .service-card:nth-child(4) {
    transition-delay: .44s;
}

/* Hover */

#services .service-card.show:hover {
    transform: translateY(-9px) scale(1.015);
    transition-delay: 0s;
}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:900px) {

    .nav {

        display: none;

    }

    .header-btn {

        display: none;

    }

    .services-grid {

