    opacity: 0;

    transition: .5s;

}


.service-card:hover {

    background:
        #e5dfd2;

    transform:
        translateY(-8px);

}


.service-card:hover::before {

    opacity: 1;

}


.service-number {

    font-family:
        "Cormorant Garamond",
        serif;

    color:
