        font-size:
            75px;

    }

    .hero-description {

        font-size:
            13px;

    }

    .services-grid {

        grid-template-columns:
            1fr;

    }

    .service-card {

        min-height:
            250px;

    }

    .featured-image {

        height:
            330px;

    }

    .featured-small {

        height:
            220px;

    }

    .about-image::after {

        top: 15px;

        right: -15px;

        bottom: -15px;

        left: 15px;

    }

    .floating-contact {

        left:
            12px;

        bottom:
            12px;

    }

    .float-btn {

        width:
            46px;

        height:
            46px;

    }

}

</style>





