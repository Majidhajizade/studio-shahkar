   FLOATING BUTTONS
===================================================== */

.floating-contact {

    position: fixed;

    left: 22px;

    bottom: 22px;

    z-index: 8000;

    display: flex;

    flex-direction: column;

    gap: 10px;

}


.float-btn {

    width: 52px;

    height: 52px;

    border-radius: 50%;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 20px;

