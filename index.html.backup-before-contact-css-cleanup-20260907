        if (!Array.isArray(images) || images.length === 0) return;

        const track = document.querySelector(".shahkar-slides");
        const dots = document.querySelector(".shahkar-dots");

        if (!track || !dots) return;

        const cleanImages = images.filter(Boolean);

        if (!cleanImages.length) return;

        track.innerHTML = cleanImages.map(function (url, index) {
            return `
                <div class="shahkar-slide${index === 0 ? " active" : ""}">
                    <img
                        src="${url}"
                        alt="نمونه عکاسی استودیو شاهکار"
                        loading="${index === 0 ? "eager" : "lazy"}"
                    >
                </div>
            `;
        }).join("");

        dots.innerHTML = cleanImages.map(function (_, index) {
            return `
                <button
                    type="button"
                    class="shahkar-dot${index === 0 ? " active" : ""}"
                    data-slide="${index}"
                    aria-label="اسلاید ${index + 1}">
                </button>
            `;
        }).join("");

        /*
         * اسکریپت اصلی اسلایدشو با اسلایدهای قدیمی
         * قبلاً اجرا شده است؛ بنابراین کنترل‌ها را
         * برای ساختار جدید دوباره راه‌اندازی می‌کنیم.
         */

        const slides = track.querySelectorAll(".shahkar-slide");
        const newDots = dots.querySelectorAll(".shahkar-dot");
        const next = document.querySelector(".shahkar-next");
        const prev = document.querySelector(".shahkar-prev");
        const slideshow = document.querySelector(".shahkar-slideshow");

        if (!slides.length || !next || !prev || !slideshow) return;

        let current = 0;
        let timer = null;

        function showSlide(index) {
            current = (index + slides.length) % slides.length;

            slides.forEach(function (slide, i) {
                slide.classList.toggle("active", i === current);
            });

            newDots.forEach(function (dot, i) {
                dot.classList.toggle("active", i === current);
            });
        }

        function startAutoPlay() {
            clearInterval(timer);
            timer = setInterval(function () {
                showSlide(current + 1);
            }, 4500);
        }

        next.onclick = function () {
            showSlide(current + 1);
            startAutoPlay();
        };

        prev.onclick = function () {
            showSlide(current - 1);
            startAutoPlay();
        };

        newDots.forEach(function (dot, i) {
            dot.onclick = function () {
                showSlide(i);
                startAutoPlay();
            };
        });

        slideshow.onmouseenter = function () {
            clearInterval(timer);
        };

        slideshow.onmouseleave = function () {
            startAutoPlay();
        };

        let touchStartX = 0;

        slideshow.ontouchstart = function (e) {
            touchStartX = e.changedTouches[0].screenX;
            clearInterval(timer);
        };

        slideshow.ontouchend = function (e) {
            const distance =
                e.changedTouches[0].screenX - touchStartX;

            if (Math.abs(distance) > 50) {
                if (distance < 0) {
                    showSlide(current + 1);
                } else {
                    showSlide(current - 1);
                }
            }

            startAutoPlay();
        };

        showSlide(0);
        startAutoPlay();

        console.log("Supabase slideshow synced:", cleanImages.length);

    }

    window.addEventListener(
        "shahkarSupabaseGalleryLoaded",
        function (event) {
            syncGallery(event.detail);
        }
    );

    /*
     * اگر Supabase قبل از این اسکریپت
     * عکس‌ها را دریافت کرده باشد.
     */
    if (Array.isArray(window.shahkarSupabaseImages)) {
        syncGallery(window.shahkarSupabaseImages);
    }

})();
</script>


<script id="shahkar-page-loader-script">
(function () {
    function finishIntro() {
        const loader = document.getElementById("shahkarPageLoader");
        document.body.classList.add("shahkar-site-ready");
        if (!loader) return;

        requestAnimationFrame(function () {
            loader.classList.add("hide");
            setTimeout(function () { loader.remove(); }, 750);
        });
    }

    if (document.readyState === "complete") {
        setTimeout(finishIntro, 500);
    } else {
        window.addEventListener("load", function () {
            setTimeout(finishIntro, 500);
        }, { once: true });
    }
})();
</script>
