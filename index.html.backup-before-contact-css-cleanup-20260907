    0%,100% {
        transform:
            scaleY(.4);
        transform-origin:
            top;
    }

    50% {
        transform:
            scaleY(1);
        transform-origin:
            top;
    }

}


@keyframes heroUp {

    from {

        opacity: 0;

        transform:
            translateY(35px);

    }

    to {

        opacity: 1;

        transform:
            translateY(0);

    }

}


